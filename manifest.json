{
  "manifest_version": 3,
  "name": "eBay Seller Feedback Filter",
  "version": "1.5.0",
  "description": "Hide eBay listings from low-feedback sellers and highlight the best deal (price, condition & seller trust). No setup, runs locally.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "eBay Seller Feedback Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ebay.com/sch/*",
        "*://*.ebay.co.uk/sch/*",
        "*://*.ebay.ca/sch/*",
        "*://*.ebay.com.au/sch/*",
        "*://*.ebay.de/sch/*",
        "*://*.ebay.fr/sch/*",
        "*://*.ebay.it/sch/*",
        "*://*.ebay.es/sch/*"
      ],
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ]
}
